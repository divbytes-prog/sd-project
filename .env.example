# Server-only configuration. Copy to .env.local; never commit populated secrets.
DATABASE_URL=postgresql://RESTRICTED_ROLE:PASSWORD@YOUR_POOLED_HOST/instituteconnect?sslmode=verify-full
NEON_AUTH_BASE_URL=https://YOUR_AUTH_HOST/instituteconnect/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_ORIGIN=http://localhost:4173
IC_OWNER_EMAIL=owner@example.com
# Only for isolated verification: never configure these in production.
# MIGRATION_DATABASE_URL=postgresql://TEST_OWNER:PASSWORD@TEST_HOST/instituteconnect?sslmode=verify-full
# IC_RUN_INTEGRATION_TESTS=true
